# ArcReel production deployment configuration (PostgreSQL)
# Copy this file to .env and fill in your values.

# ============================================================
# Authentication
# ============================================================
# Login username (default: admin)
AUTH_USERNAME=admin
# Login password (leave empty to auto-generate it on first startup and write it back to .env)
AUTH_PASSWORD=
# JWT signing secret (leave empty to auto-generate it; existing tokens become invalid after restart)
AUTH_TOKEN_SECRET=

# ============================================================
# PostgreSQL
# ============================================================
# Database password (required; docker-compose validates this at startup)
# Use alphanumeric characters only to avoid DATABASE_URL parsing issues with special characters like @ # / ? %
# Example generator: openssl rand -hex 16
POSTGRES_PASSWORD=

# ============================================================
# Logging
# ============================================================
# Log level (default: INFO; options: DEBUG, WARNING, ERROR)
# LOG_LEVEL=INFO
